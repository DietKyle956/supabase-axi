# Supabase project configuration for supabase-axi
# Copy this file to .supabase.env and fill in your values.
# Run `supabase-axi init` to auto-discover from local Supabase CLI config.

SUPABASE_PROJECT_REF=your_project_ref_here
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
